# Configuration for Family Vacation Packing App
# Default location on LXC: /etc/packing-list/packing-list.env

# Server bind host and port
PACKING_HOST=0.0.0.0
PACKING_PORT=8000

# SQLite Database path (WAL mode enabled automatically)
# Dedicated data/ directory keeps .db, -wal, and -shm files isolated
PACKING_DB_PATH=/opt/packing-app/data/packing.db

# Frontend static files directory (defaults to ./frontend)
PACKING_FRONTEND_DIR=/opt/packing-app/frontend
PACKING_SERVE_FRONTEND=true

# Logging: text (for development) or json (for journald)
PACKING_LOG_LEVEL=INFO
PACKING_LOG_FORMAT=json

# Pre-populate sensible Hebrew family vacation templates on first boot
PACKING_SEED=true
